# Names only. Real values go in .env.local (git-ignored) and in Vercel env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server only. For now (slice 3) it is used by the content scripts on your own machine: keep it in .env.local, never in Vercel and never in a NEXT_PUBLIC variable.
ANTHROPIC_API_KEY=
MODEL_ADMIN=claude-opus-5-5
MODEL_MEMBER=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to 1 to show the /design component page in production builds (it is always available in dev).
SHOW_DESIGN_PAGE=
# Game layer (treats, level, streak): 1 = on, 0 = off. Unset = on in development, off in production. Built, but has no real data until slice 10.
NEXT_PUBLIC_GAME_LAYER=
